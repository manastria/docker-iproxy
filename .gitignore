# Contient des secrets (mot de passe WebUI qBittorrent) : ne jamais versionner.
# Template versionné : .env.sample
.env

apt-cache/*
!apt-cache/.gitkeep
apt-logs/*
!apt-logs/.gitkeep
docker-cache/*
!docker-cache/.gitkeep
git-daemon/repos/*
!git-daemon/repos/.gitkeep
qbittorrent/*
!qbittorrent/.gitkeep
torrents/*
!torrents/.gitkeep
